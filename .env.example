# Copy this file to .env. Generate each blank credential independently, for example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"

# Deployment mode: local, staging, or prod
APP_ENV=local
AUTH_ENABLED=true

# Application signing secret
JWT_SECRET_KEY=

# PostgreSQL credential used by both PostgreSQL and the backend DATABASE_URL
POSTGRES_PASSWORD=

# MinIO credentials used by both MinIO and Milvus
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Neo4j credentials
NEO4J_ENABLED=false
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Chat/research: supply the model name supported by your chat-completions provider
LLM_MODEL_NAME=gemini-3-flash-preview
LLM_BASE_URL=
LLM_API_KEY=

# Retrieval embeddings: API is the default; these credentials are independent of LLM
EMBEDDING_MODE=api
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_API_TIMEOUT_SECONDS=120
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=1024

# API chunking uses a standalone tokenizer (about 17 MB), not model weights
# Docker prepares it during build; local Python: python backend/scripts/prepare_chunk_tokenizer.py
CHUNK_TOKENIZER_PATH=resources/tokenizers/bge-m3/tokenizer.json
CHUNK_TOKENIZER_SHA256=21106b6d7dab2952c1d496fb21d5dc9db75c28ed361a05f5020bbba27810dd08

# Reranking: use the full endpoint URL
RERANK_MODE=api
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENDPOINT=https://api.siliconflow.cn/v1/rerank
RERANK_API_KEY=
RERANK_API_TIMEOUT_SECONDS=120

# PDF upload parsing; get a token from mineru.net
MINERU_ENABLED=true
MINERU_API_BASE_URL=https://mineru.net/api/v4
MINERU_API_TOKEN=

# Optional web search
TAVILY_API_KEY=

# Optional local-model Compose override; directories must already contain weights
# LOCAL_EMBEDDING_MODEL_DIR=./models/bge-m3
# LOCAL_RERANK_MODEL_DIR=./models/bge-reranker-v2-m3
